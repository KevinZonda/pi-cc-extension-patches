{
  "name": "pi-cc-extension-patches",
  "version": "0.3.1",
  "description": "Personal UI patches for pi-cc-extensions: header, compact messages, tool status dots, star spinners, per-turn verbs, and Claude Dark theme.",
  "type": "module",
  "license": "MIT",
  "author": "KevinZonda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinZonda/pi-cc-extension-patches.git"
  },
  "homepage": "https://github.com/KevinZonda/pi-cc-extension-patches#readme",
  "bugs": {
    "url": "https://github.com/KevinZonda/pi-cc-extension-patches/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "claude-code"
  ],
  "files": [
    "extensions",
    "themes",
    "assets",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "themes": [
      "./themes/claude-dark.json"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:dry-run": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3"
  }
}
